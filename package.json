{
  "name": "mastro-connect",
  "version": "0.2.0",
  "description": "Build agent connectors for web apps: capture your browser session, describe the app's API in OpenAPI, drive it from the terminal.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastro-hq/mastro-connect.git"
  },
  "homepage": "https://github.com/mastro-hq/mastro-connect#readme",
  "bugs": "https://github.com/mastro-hq/mastro-connect/issues",
  "keywords": [
    "agents",
    "connectors",
    "cli",
    "skills",
    "openapi",
    "browser-automation"
  ],
  "bin": {
    "mastro": "bin/mastro.cjs",
    "mastro-connect": "bin/mastro.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "providers/",
    "skills/",
    "extension/",
    "docs/"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p extension/tsconfig.json",
    "typecheck:ext": "tsc --noEmit -p extension/tsconfig.json",
    "test": "bun test",
    "build": "bun build packages/cli/src/bin.ts --target=bun --outdir dist",
    "prepack": "bun run build",
    "mastro": "bun run packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.1.42",
    "typescript": "^6.0.3"
  }
}
