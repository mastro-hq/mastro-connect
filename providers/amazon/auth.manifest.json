{
  "schema_version": "browser-auth-manifest/v1",
  "provider_id": "amazon",
  "display_name": "Amazon",
  "launch": {
    "url": "https://www.amazon.com/",
    "open_tab": true,
    "expected_origins": ["https://www.amazon.com"],
    "timeout_seconds": 180
  },
  "permissions": {
    "host_permissions": ["https://www.amazon.com/*"],
    "observes_cookies": true,
    "observes_request_headers": false,
    "observes_request_body": false,
    "observes_response_headers": false,
    "injects_page_bridge": false,
    "observes_storage": false
  },
  "capture": {
    "cookies": [
      {
        "url": "https://www.amazon.com",
        "include_names_matching": [".*"],
        "save_as": "cookies"
      }
    ]
  },
  "completion": {
    "all": [
      { "cookie_present": "at-main" },
      { "cookie_present": "session-id" }
    ]
  },
  "serialization": {
    "output_schema": "capture-bundle/amazon-web/v1",
    "fields": {
      "session_id": "${cookies.session-id.value}",
      "cookie_header": "${cookies.as_header}"
    }
  },
  "security": {
    "redact_fields": ["cookie_header"],
    "persist_minimum": true,
    "allowed_postback_origin": "http://127.0.0.1"
  }
}
