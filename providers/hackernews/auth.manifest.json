{
  "schema_version": "browser-auth-manifest/v1",
  "provider_id": "hackernews",
  "display_name": "Hacker News (example)",
  "launch": {
    "url": "https://news.ycombinator.com/",
    "open_tab": true,
    "expected_origins": ["https://news.ycombinator.com"],
    "timeout_seconds": 180
  },
  "permissions": {
    "host_permissions": ["https://news.ycombinator.com/*"],
    "observes_cookies": true,
    "observes_request_headers": false,
    "observes_request_body": false,
    "observes_response_headers": false,
    "injects_page_bridge": false,
    "observes_storage": false
  },
  "capture": {
    "cookies": [
      {
        "url": "https://news.ycombinator.com",
        "include_names_matching": ["^user$"],
        "save_as": "cookies"
      }
    ]
  },
  "completion": {
    "all": [{ "cookie_present": "user" }]
  },
  "serialization": {
    "output_schema": "capture-bundle/hackernews-web/v1",
    "fields": {
      "cookie_header": "${cookies.as_header}"
    }
  },
  "security": {
    "redact_fields": ["cookie_header"],
    "persist_minimum": true,
    "allowed_postback_origin": "http://127.0.0.1"
  }
}
