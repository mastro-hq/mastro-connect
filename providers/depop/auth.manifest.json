{
  "schema_version": "browser-auth-manifest/v1",
  "provider_id": "depop",
  "display_name": "Depop",
  "launch": {
    "url": "https://www.depop.com/",
    "open_tab": true,
    "expected_origins": ["https://www.depop.com"],
    "timeout_seconds": 180
  },
  "permissions": {
    "host_permissions": [
      "https://www.depop.com/*",
      "https://webapi.depop.com/*"
    ],
    "observes_cookies": true,
    "observes_request_headers": false,
    "observes_request_body": false,
    "observes_response_headers": false,
    "injects_page_bridge": false,
    "observes_storage": false
  },
  "capture": {
    "cookies": [
      {
        "url": "https://www.depop.com",
        "include_names_matching": [".*"],
        "save_as": "cookies"
      }
    ]
  },
  "completion": {
    "all": [
      { "cookie_present": "access_token" },
      { "cookie_present": "user_id" }
    ]
  },
  "serialization": {
    "output_schema": "capture-bundle/depop-web/v1",
    "fields": {
      "access_token": "${cookies.access_token.value}",
      "user_id": "${cookies.user_id.value}",
      "cookie_header": "${cookies.as_header}"
    }
  },
  "security": {
    "redact_fields": ["access_token", "cookie_header"],
    "persist_minimum": true,
    "allowed_postback_origin": "http://127.0.0.1"
  }
}
